# ============================
# Backend API Configuration
# ============================

# Java backend base URL (if used)
JAVA_API_BASE=http://localhost:8080

# Python FastAPI backend base URL
PYTHON_API_BASE=http://127.0.0.1:8000

# Which backend the UI should talk to: "python" or "java"
API_BACKEND=python


# ============================
# Frontend App Settings
# ============================

NEXT_PUBLIC_APP_NAME="AI Knowledge Hub"

# Authentication mode (optional)
# Options: jwt | none
NEXT_PUBLIC_AUTH_MODE=jwt


# ============================
# Optional UI Settings
# ============================

# Enable debug logs in browser console
NEXT_PUBLIC_DEBUG=false

# Default timeout for API fetch requests
NEXT_PUBLIC_API_TIMEOUT=15000
